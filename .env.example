# Credenciales de tu app en https://developer.spotify.com/dashboard
# (Client Credentials Flow — solo lee catálogo público, no necesita login
# de usuario). Cargalas en Netlify: Site settings → Environment variables.
# Para probar en tu máquina con `netlify dev`, copiá este archivo a `.env`
# (ya está en .gitignore, nunca se sube al repo) y completá los valores.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Portal de artistas: clave secreta de Supabase (Project Settings → API →
# service_role / secret). La usa netlify/functions/portal-files.js para
# leer el link de la carpeta de OneDrive de cada artista. Nunca va en el
# código ni en el navegador: solo en las variables de entorno de Netlify.
SUPABASE_SERVICE_ROLE_KEY=

# ZG PASS (entradas). Todas se cargan en Netlify, nunca en el código.
# - MP_ACCESS_TOKEN: credencial de Mercado Pago. En el sitio de pruebas
#   (rama "pruebas") va la de prueba; en el real, la productiva.
# - MP_WEBHOOK_SECRET: clave con la que Mercado Pago firma sus avisos de pago.
# - PASS_TEST_MODE: "1" solo en el sitio de pruebas; ahí se venden únicamente
#   los eventos marcados como prueba.
# - RESEND_API_KEY: para mandar los mails de las entradas y los avisos.
# - PASS_NOTIFY_EMAIL: (opcional) a dónde llegan los avisos internos.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PASS_TEST_MODE=
RESEND_API_KEY=
PASS_NOTIFY_EMAIL=

# Portal de artistas — "Tus canciones" y el aviso de la próxima sesión.
# - NOTION_TOKEN: clave de una integración interna de Notion
#   (notion.so/profile/integrations → Nueva integración, solo lectura).
#   En Notion hay que conectarla a las bases "Canciones" y "Tareas
#   Pendientes" (··· → Conexiones). La usa netlify/functions/portal-songs.js.
NOTION_TOKEN=
